# Copy this file to config/nuc.env on each NUC, edit the five values, then:
#   export FSM_ROOT="$(pwd -P)"; source "$FSM_ROOT/config/load_nuc_env.sh"
# config/nuc.env is intentionally ignored by Git.

# Python environment containing onnxruntime, cyclonedds and unitree_sdk2py.
LOCOMOTION_RUNTIME_PYTHON="$HOME/miniconda3/envs/locomotion_controller/bin/python"
# Usually the environment prefix containing bin/python and lib/.
LOCOMOTION_RUNTIME_HOME="$HOME/miniconda3/envs/locomotion_controller"

# This NUC's Ethernet interface connected to the robot and the robot address.
LOCOMOTION_NETWORK_INTERFACE="enp86s0"
LOCOMOTION_ROBOT_IP="192.168.123.161"

# Writable per-NUC log directory. It does not need to be inside the repository.
LOCOMOTION_LOG_ROOT="$HOME/.local/state/locomotion_controller"

# Optional. Change only when multiple controller instances share one NUC.
LOCOMOTION_SOCKET_PATH="/tmp/locomotion_controller.sock"
